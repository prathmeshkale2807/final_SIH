# ==============================================================================
# KRISHAK — VERCEL PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Add these variables in Vercel Dashboard -> Project -> Settings -> Environment Variables
# NEVER commit real secret values to GitHub repository.

# ─── 1. SERVERLESS AUTHENTICATION & SECURITY SECRETS ───────────────────────────
NODE_ENV=production
AUTH_SECRET=your_super_secret_auth_encryption_key_here
JWT_SECRET=your_jwt_signing_secret_here
ADMIN_PASSWORD=your_secure_admin_password_here

# ─── 2. REAL SMS GATEWAY PROVIDER CONFIGURATION ────────────────────────────────
# Options: '2factor' | 'fast2sms' | 'msg91' | 'twilio'
SMS_PROVIDER=2factor

# 2Factor.in (Recommended for India DLT SMS)
TWO_FACTOR_API_KEY=your_2factor_api_key_here
TWO_FACTOR_TEMPLATE_NAME=OTP1

# Fast2SMS (Alternative Indian SMS Provider)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# MSG91 (Alternative Indian SMS Provider)
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_TEMPLATE_ID=your_msg91_template_id_here

# Twilio (Global SMS Gateway)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# ─── 3. DATABASE & FIREBASE ADMIN SDK (SERVER-SIDE ONLY) ────────────────────────
FIREBASE_PROJECT_ID=hackathon8080-d367a
# Optional: Minified JSON string of Firebase service account key
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# Optional: Google Gemini Vision API Key for Computer Vision produce analysis
GEMINI_API_KEY=your_google_ai_gemini_api_key_here

# ─── 4. FRONTEND PUBLIC ENVIRONMENT VARIABLES (VITE_) ──────────────────────────
# Leave VITE_API_URL blank on Vercel to automatically use relative /api
VITE_API_URL=
VITE_AUTH_MODE=sms_otp

# Firebase Client Configuration (Public)
VITE_FIREBASE_API_KEY=your_firebase_client_api_key
VITE_FIREBASE_AUTH_DOMAIN=hackathon8080-d367a.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=hackathon8080-d367a
VITE_FIREBASE_STORAGE_BUCKET=hackathon8080-d367a.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=849988593136
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_firebase_measurement_id

# OpenRouteService – Road Routing API Key
VITE_ORS_API_KEY=your_ors_api_key_here
